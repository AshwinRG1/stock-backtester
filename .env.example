# Copy this file to .env and fill in values as needed.
# .env is gitignored — never check it into version control.

# Required for Phase 5 (POST /api/agent endpoint).
# Get a key from https://console.anthropic.com/ — new accounts receive
# $5 of signup credit, which is plenty for development at this scale
# (each agent call costs roughly $0.003–0.01 with claude-sonnet-4-6).
# If unset, the /api/agent endpoint returns 503; the rest of the API
# continues to work normally.
ANTHROPIC_API_KEY=

# Optional: override the default ticker used in manual runs
DEFAULT_TICKER=AAPL

# Optional: yfinance data period and interval defaults
DEFAULT_PERIOD=1y
DEFAULT_INTERVAL=1d
